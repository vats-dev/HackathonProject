{
  "manifest_version": 3,
  "name": "Smart CPU Job Scheduler",
  "version": "1.0",
  "description": "AI-Powered OS Task Scheduling System Dashboard",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Scheduler Dashboard"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
